# Keep secrets server-side. Never prefix them with NEXT_PUBLIC_.
UNIPILE_API_KEY=
UNIPILE_API_BASE_URL=https://api.unipile.com
APP_URL=http://localhost:3000
# Optional hosted Postgres URL. Leave empty to use SQLite locally.
DATABASE_URL=
FASTAPI_BASE_URL=http://127.0.0.1:8001
LOCAL_API_TOKEN=generate-a-long-random-local-token
Open_Router_Api_Key=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Existing account that should become the bootstrapped super admin.
# The API never creates this account when other users already exist.
# On a brand-new database, SUPERADMIN_INITIAL_PASSWORD creates this one account. Remove that password after the first sign-in.
SUPERADMIN_EMAIL=
SUPERADMIN_INITIAL_PASSWORD=
# SQLite file used only when DATABASE_URL is empty. Docker defaults to /app/data/phigrad-crm.sqlite3.
CRM_DATABASE_PATH=
# Set to production so invitation links are not printed in the API console.
PHIGRAD_ENV=development
# Leave SMTP_HOST empty in local development. Invitation links are printed in the API console.
# When SMTP_HOST is set, invitations are emailed and the link is not printed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
